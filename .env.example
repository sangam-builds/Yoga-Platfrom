# ==============================================================================
# ZenFlow - Environment Variables Template
# Copy this file to .env.local for Next.js, and .env for Prisma CLI.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Authentication & Client Configuration
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Strings (Supabase / Neon / Any PostgreSQL)
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection string
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler (port 6543) - used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Direct session connection (port 5432) - required by Prisma Migrate / prisma db push
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"
